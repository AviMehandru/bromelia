<Project Sdk="Microsoft.NET.Sdk">

  <!-- The scenario test unit (rearchitecture plan §5.1, decision 167): TestCompositionRoot builds the engine the real
       root builds, over the test kit's fakes; LocalEngine's harness and (session H) the scenario runner use it. -->
  <PropertyGroup>
    <TargetFramework>$(BromeliaTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>11</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bromelia.Scenarios.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Bromelia.Foundation.Tests\Fixtures.cs" Link="Fixtures.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bromelia.Engine\Bromelia.Engine.csproj" />
    <ProjectReference Include="..\..\src\Bromelia.Adapters\Bromelia.Adapters.csproj" />
    <ProjectReference Include="..\Bromelia.TestKit\Bromelia.TestKit.csproj" />
  </ItemGroup>

</Project>
