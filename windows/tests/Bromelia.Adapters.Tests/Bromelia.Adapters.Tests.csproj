<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(BromeliaTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>11</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bromelia.Adapters.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Bromelia.Foundation.Tests\Fixtures.cs" Link="Fixtures.cs" />
    <Compile Include="..\Bromelia.Foundation.Tests\English.cs" Link="English.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bromelia.Adapters\Bromelia.Adapters.csproj" />
  </ItemGroup>

</Project>
