<Project Sdk="Microsoft.NET.Sdk">

  <!-- L1 Domain (rearchitecture plan §3.1): pure functions and value types. No I/O, no clock, no threads,
       no globals, no package references; Foundation only. -->
  <PropertyGroup>
    <TargetFramework>$(BromeliaTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>11</LangVersion>
    <RootNamespace>Bromelia.Domain</RootNamespace>
    <AssemblyName>Bromelia.Domain</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bromelia.Foundation\Bromelia.Foundation.csproj" />
  </ItemGroup>

</Project>
