<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral engine: robot-protocol parsing, configuration, title rules, job pipeline.
       Builds on any OS so it can be unit tested without Windows. The WinUI app references it. -->
  <PropertyGroup>
    <TargetFramework>$(BromeliaTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>11</LangVersion>
    <RootNamespace>Bromelia.Core</RootNamespace>
    <AssemblyName>Bromelia.Core</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\shared\catalog\settings-catalog.json" Link="settings-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
