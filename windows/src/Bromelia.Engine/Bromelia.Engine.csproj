<Project Sdk="Microsoft.NET.Sdk">

  <!-- L4 Engine (rearchitecture plan §3.2, §11): the executor, the event bus, services, the scheduler, the pipeline
       and its steps. Reaches the outside world only through the ports: no adapters, no platform APIs. -->
  <PropertyGroup>
    <TargetFramework>$(BromeliaTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>11</LangVersion>
    <RootNamespace>Bromelia.Engine</RootNamespace>
    <AssemblyName>Bromelia.Engine</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bromelia.Foundation\Bromelia.Foundation.csproj" />
    <ProjectReference Include="..\Bromelia.Domain\Bromelia.Domain.csproj" />
    <ProjectReference Include="..\Bromelia.Ports\Bromelia.Ports.csproj" />
  </ItemGroup>

</Project>
