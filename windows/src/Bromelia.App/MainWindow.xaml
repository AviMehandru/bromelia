<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bromelia.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bromelia">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="290"
            SelectionChanged="Nav_SelectionChanged"
            ItemInvoked="Nav_ItemInvoked">

            <NavigationView.PaneFooter>
                <StackPanel Margin="16,4,16,12" Spacing="2">
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ScanText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <InfoBar x:Name="ProblemBar" Severity="Error" IsOpen="False" Margin="12,8,12,0" Title="MakeMKV" Closed="ProblemBar_Closed">
                        <InfoBar.ActionButton>
                            <Button x:Name="BetaKeyButton" Content="Get the current beta key" Click="BetaKeyButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="ErrorBar" Severity="Warning" IsOpen="False" Margin="12,8,12,0" Closed="ErrorBar_Closed" />
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
