    'core/bro-stream-item.c',
    'core/bro-subscription.c',
    'pipeline/bro-catalog-queries.c',
    'pipeline/bro-checkpointer.c',
    'pipeline/bro-commit-result.c',
    'pipeline/bro-config-source.c',
    'pipeline/bro-decision-port.c',
    'pipeline/bro-drive-location.c',
    'pipeline/bro-drive-lookup.c',
    'pipeline/bro-job-log.c',
    'pipeline/bro-job-logger.c',
    'pipeline/bro-job-planner.c',
    'pipeline/bro-library-handle.c',
    'pipeline/bro-library-port.c',
    'pipeline/bro-makemkv-setup.c',
    'pipeline/bro-pipeline-runner.c',
    'pipeline/bro-progress-reporter.c',
    'pipeline/bro-space-reservations.c',
    'pipeline/bro-step.c',
    'pipeline/bro-step-context.c',
    'pipeline/bro-step-environment.c',
    'pipeline/bro-step-registry.c',
    'pipeline/bro-step-report.c',
    'pipeline/bro-tool-set.c',
    'services/bro-config-service.c',
    'services/bro-drive-service.c',
    'services/bro-job-service.c',
    'services/bro-library-service.c',
    'services/bro-makemkv-service.c',
    'services/bro-problem-service.c',
    'services/bro-recovery-service.c',
    'services/bro-secret-source.c',
    'steps/bro-acquire-output.c',
    'steps/bro-acquire-step.c',
    'steps/bro-acquired-title.c',
    'steps/bro-archive-check.c',
    'steps/bro-archived-match.c',
    'steps/bro-await-media-step.c',
    'steps/bro-backup-check.c',
    'steps/bro-decide-step.c',
    'steps/bro-file-tree.c',
    'steps/bro-identify-step.c',
    'steps/bro-makemkv-sink.c',
    'steps/bro-name-output.c',
