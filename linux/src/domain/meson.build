# L1 Domain (rearchitecture plan §3.1): pure functions and value types. GLib's core only (no GIO, no GObject).
bro_domain_inc = include_directories(
  'config',
  'fingerprint',
  'identity',
  'jobs',
  'listing',
  'messages',
  'outcome',
  'robot',
  'titles',
)

bro_domain_lib = static_library('bro-domain',
  files(
    'config/bro-drive-entry.c',
    'config/bro-drive-match.c',
    'config/bro-index-base.c',
    'config/bro-title-settings.c',
    'config/bro-title-strategy.c',
    'fingerprint/bro-fingerprint.c',
    'identity/bro-archived-disc.c',
    'identity/bro-continuation-query.c',
    'identity/bro-decision.c',
    'identity/bro-disc-format.c',
    'identity/bro-episode-continuation.c',
    'identity/bro-format-detector.c',
    'identity/bro-identity-inputs.c',
    'identity/bro-identity.c',
    'identity/bro-kind-heuristics.c',
    'identity/bro-label-parser.c',
    'identity/bro-label.c',
    'identity/bro-media-kind.c',
    'identity/bro-menu-numbers.c',
    'identity/bro-previous-episode.c',
    'jobs/bro-job-kind.c',
    'jobs/bro-job-plan.c',
    'jobs/bro-job-request.c',
    'jobs/bro-job-snapshot.c',
    'jobs/bro-job-state.c',
    'jobs/bro-outcome.c',
    'jobs/bro-queue.c',
    'jobs/bro-resource-set.c',
    'jobs/bro-resumability.c',
    'jobs/bro-step-kind.c',
    'jobs/bro-step-output.c',
    'jobs/bro-status-word.c',
    'jobs/bro-step-state.c',
    'listing/bro-disc-type.c',
    'listing/bro-libre-drive-state.c',
    'listing/bro-listing-builder.c',
    'listing/bro-listing.c',
    'listing/bro-title.c',
    'listing/bro-track.c',
    'listing/bro-track-kind.c',
    'messages/bro-bro-message.c',
    'messages/bro-message-code.c',
    'messages/bro-severity.c',
    'outcome/bro-decided.c',
    'outcome/bro-job-outcome.c',
    'outcome/bro-process-exit.c',
    'outcome/bro-run-outcome.c',
    'outcome/bro-step-result.c',
    'robot/bro-disc-flags.c',
    'robot/bro-drive-join.c',
    'robot/bro-drive-state.c',
    'robot/bro-joined-drive.c',
    'robot/bro-makemkv-drive.c',
    'robot/bro-makemkv-notice.c',
    'robot/bro-message-catalog.c',
    'robot/bro-message-kind.c',
    'robot/bro-os-drive.c',
    'robot/bro-robot-event.c',
    'robot/bro-robot-message.c',
    'robot/bro-robot.c',
    'robot/bro-run-accumulator.c',
    'titles/bro-listing-match.c',
    'titles/bro-one-pass.c',
    'titles/bro-selection-trace.c',
    'titles/bro-selection.c',
    'titles/bro-space-estimate.c',
    'titles/bro-title-rules.c',
  ),
  include_directories: bro_domain_inc,
  dependencies: bro_foundation_dep,
)

bro_domain_dep = declare_dependency(
  link_with: bro_domain_lib,
  include_directories: bro_domain_inc,
  dependencies: bro_foundation_dep,
)
