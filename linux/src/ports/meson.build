# L2 Ports (rearchitecture plan §9): GObject interfaces and plain records, no logic.
gobject_dep = dependency('gobject-2.0')

bro_ports_lib = static_library('bro-ports',
  files(
    'bro-byte-stream.c',
    'bro-catalog-repository.c',
    'bro-check-record.c',
    'bro-check-repository.c',
    'bro-clock.c',
    'bro-commit-intent.c',
    'bro-commit-item.c',
    'bro-desktop-notifier.c',
    'bro-device-event.c',
    'bro-device-monitor.c',
    'bro-directory-entry.c',
    'bro-disc-set-record.c',
    'bro-drive-control.c',
    'bro-drive-record.c',
    'bro-drive-repository.c',
    'bro-drive-stats.c',
    'bro-file-info.c',
    'bro-file-system.c',
    'bro-http-client.c',
    'bro-http-response.c',
    'bro-isolation-lease.c',
    'bro-job-query.c',
    'bro-job-record.c',
    'bro-job-repository.c',
    'bro-key-value-repository.c',
    'bro-keystore.c',
    'bro-lookup-cache-repository.c',
    'bro-makemkv-run-settings.c',
    'bro-move-policy.c',
    'bro-moved-item.c',
    'bro-outbox-entry.c',
    'bro-outbox-repository.c',
    'bro-output-line.c',
    'bro-output-source.c',
    'bro-power-guard.c',
    'bro-power-manager.c',
    'bro-process-launcher.c',
    'bro-process-spec.c',
    'bro-replica-record.c',
    'bro-replica-repository.c',
    'bro-replica-state.c',
    'bro-running-process.c',
    'bro-sector-reader.c',
    'bro-service-installer.c',
    'bro-settings-isolation.c',
    'bro-step-record.c',
    'bro-step-repository.c',
    'bro-stop-policy.c',
    'bro-stop-reason.c',
    'bro-store.c',
    'bro-timer-handle.c',
    'bro-timer-schedule.c',
    'bro-tool-info.c',
    'bro-tool-kind.c',
    'bro-tool-locator.c',
    'bro-unit-file.c',
    'bro-unit-query.c',
    'bro-unit-record.c',
    'bro-unit-repository.c',
    'bro-unit-state.c',
    'bro-unit-status.c',
    'bro-volume-info.c',
    'bro-work-record.c',
  ),
  include_directories: include_directories('.'),
  dependencies: [bro_domain_dep, gobject_dep],
)

bro_ports_dep = declare_dependency(
  link_with: bro_ports_lib,
  include_directories: include_directories('.'),
  dependencies: [bro_domain_dep, gobject_dep],
)
