    {
      "id": "a-keystore-failure-is-the-call's",
      "from": [
        "rearchitecture-plan §24; ConfigService.secret: the first failure when no source has it"
      ],
      "given": {
        "config": {
          "version": 3,
          "makemkv": {
            "registrationKey": {
              "secret": "makemkv.key"
            }
          }
        },
        "keystoreFails": {
          "makemkv.key": {
            "code": "keystore.failed",
            "params": {
              "name": "makemkv.key",
              "reason": "locked"
            }
          }
        },
        "userSettings": "app_Key = \"M-installed\"\ndvd_MinimumTitleLength = \"999\"\n"
      },
      "expect": {
        "error": {
          "code": "keystore.failed",
          "params": {
            "name": "makemkv.key",
            "reason": "locked"
          }
        }
      }
    },
    {
      "id": "an-unreadable-user-settings-file-is-the-call's",
      "from": [
        "new: MakeMKV can't read it either (it runs as the same user)"
      ],
      "given": {
        "config": {
          "version": 3
        },
        "userSettings": "app_Key = \"M-installed\"\ndvd_MinimumTitleLength = \"999\"\n",
        "userSettingsFails": {
          "code": "fs.failed",
          "params": {
            "operation": "read",
            "path": "/home/u/.MakeMKV/settings.conf",
            "reason": "Permission denied"
          }
        }
      },
      "expect": {
        "error": {
          "code": "fs.failed",
          "params": {
            "operation": "read",
            "path": "/home/u/.MakeMKV/settings.conf",
            "reason": "Permission denied"
          }
        }
      }
    },
