{
  "functions": [
    "Sha256Sums.parse",
    "Sha256Sums.render",
    "Sha256Sums.merge",
    "ArchiveFiles.isOwnFile",
    "ArchiveFiles.isLeftover",
    "ArchiveFiles.isMetadataFile",
    "ArchiveFiles.expand",
    "VerifyResult.compare"
  ],
  "description": "SHA256SUMS, Bromelia's own file names (not reported as unlisted), media server metadata files (not in SHA256SUMS), and the verdict of a check. A check's per-file input says whether the file hashed the same, changed, is missing or unreadable. isLeftover: .<name>.bromelia-tmp-<id> (writeAtomically) and .<name>.part-<id> (DataImager), what a stopped write leaves.",
  "cases": [
    {
      "id": "sha256-abc",
      "from": [
        "macos ChecksumTests.hashesFilesAndFolders",
        "windows ChecksumTests.HashesFilesAndFolders",
        "linux /archive/checksums"
      ],
      "given": {
        "bytes": "abc"
      },
      "expect": {
        "sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
      }
    },
    {
      "id": "sums-render",
      "from": [
        "macos ChecksumTests.hashesFilesAndFolders"
      ],
      "given": {
        "entries": [
          {
            "path": "backup/VIDEO_TS/VIDEO_TS.IFO",
            "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          },
          {
            "path": "a.mkv",
            "sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
          }
        ]
      },
      "expect": {
        "text": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  a.mkv\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  backup/VIDEO_TS/VIDEO_TS.IFO\n",
        "rule": "'<sha256>  <path>' per line, sorted by path, '/' separated, a final newline: what sha256sum -c and shasum -a 256 -c read (I4)."
      }
    },
    {
      "id": "sums-render-code-point-order",
      "from": [
        "rebuild: SHA256SUMS is sorted in code point order (UTF-8 bytes, like LC_ALL=C sort), so its bytes are the same on every platform"
      ],
      "given": {
        "entries": [
          {
            "path": "😀.mkv",
            "sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
          },
          {
            "path": "Ａ.mkv",
            "sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
          },
          {
            "path": "a.mkv",
            "sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
          }
        ]
      },
      "expect": {
        "text": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  a.mkv\nba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  Ａ.mkv\nba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  😀.mkv\n"
      }
    },
    {
      "id": "sums-parse",
      "from": [
        "macos ChecksumTests.hashesFilesAndFolders"
      ],
      "given": {
        "text": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  a.mkv\nba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad *b c.mkv\n\n"
      },
      "expect": {
        "entries": [
          {
            "path": "a.mkv",
            "sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
          },
          {
            "path": "b c.mkv",
            "sha256": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
          }
        ]
      }
    },
    {
      "id": "sums-merge",
      "from": [
        "docs/configuration.md#archive-files (entries of earlier jobs writing into the same folder are kept)"
      ],
      "given": {
        "existing": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  Season 02/E01.mkv\n",
        "entries": [
          {
            "path": "Season 02/E02.mkv",
