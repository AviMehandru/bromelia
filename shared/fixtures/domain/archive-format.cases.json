      }
    },
    {
      "id": "verify-compare",
      "from": [
        "macos ArchiveCheckTests.verifiesArchives",
        "windows ArchiveCheckTests.VerifiesArchives",
        "linux /archive/verify"
      ],
      "given": {
        "sums": [
          "Season 01/E01.mkv",
          "Season 01/E02.mkv",
          "Season 01/E03.mkv"
        ],
        "hashes": {
          "Season 01/E01.mkv": "changed",
          "Season 01/E02.mkv": "missing",
          "Season 01/E03.mkv": "same"
        },
        "folder": [
          "Season 01/E01.mkv",
          "Season 01/E03.mkv",
          "Season 01/E01.srt",
          "Season 01/E02.nfo",
          "poster.jpg",
          "bromelia.json",
          "bromelia-log.txt",
          "makemkv-log.txt",
          "makemkv-debug-log-1.txt",
          "SHA256SUMS"
        ]
      },
      "expect": {
        "result": "damaged",
        "changed": [
          "Season 01/E01.mkv"
        ],
        "missing": [
          "Season 01/E02.mkv"
        ],
        "unreadable": [],
        "unlisted": [
          "Season 01/E01.srt"
        ],
        "files": 3,
        "summary": {
          "code": "check.damaged",
          "params": {
            "parts": [
              {
                "code": "check.part.changed",
                "params": {
                  "count": 1
                }
              },
              {
                "code": "check.part.missing",
                "params": {
                  "count": 1
                }
              }
            ],
            "files": 3,
            "unlisted": 1
          }
        },
        "summaryText": "1 changed, 1 missing of 3 files; 1 not listed"
      }
    },
    {
      "id": "verify-ok",
      "from": [
        "macos ArchiveCheckTests.verifiesArchives"
      ],
      "given": {
        "sums": [
          "Good.mkv",
          "Backup/BDMV/index.bdmv"
        ],
        "hashes": {
          "Good.mkv": "same",
          "Backup/BDMV/index.bdmv": "same"
        },
        "folder": [
          "Good.mkv",
          "Backup/BDMV/index.bdmv",
          "SHA256SUMS"
        ]
      },
      "expect": {
        "result": "ok",
        "files": 2,
        "unlisted": [],
        "summary": {
          "code": "check.ok",
          "params": {
            "files": 2,
            "unlisted": 0
          }
        },
        "summaryText": "2 files OK"
      }
    },
    {
      "id": "verify-sums-empty",
      "from": [
        "macos ArchiveVerifier.verify (SHA256SUMS lists no files)"
      ],
      "given": {
        "sums": [],
        "hashes": {},
        "folder": [
          "SHA256SUMS"
        ]
      },
      "expect": {
        "result": "error",
        "error": {
          "code": "check.sumsEmpty"
        }
      }
    }
