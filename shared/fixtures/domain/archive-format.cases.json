      },
      "expect": {
        "text": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  Season 02/E01.mkv\nba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  Season 02/E02.mkv\n"
