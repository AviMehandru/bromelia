    {
      "id": "resolve-layers",
      "from": [
        "rearchitecture-plan §24 (defaults → default profile → drive's profile → drive overrides → rules → session)"
      ],
      "given": {
        "config": {
          "version": 3,
          "profiles": [
            {
              "id": "default",
              "name": "D",
              "titles": {
                "strategy": "longest"
              },
              "naming": {
                "layout": "mediaServer"
              }
            },
            {
              "id": "left",
              "name": "L",
              "mode": {
                "default": "backupThenMkv"
              },
              "titles": {
                "longestCount": 2
              }
            }
          ],
          "drives": [
            {
              "id": "d1",
              "match": {
                "devicePath": "/dev/a"
              },
              "profile": "left",
              "makemkvSettings": {
                "io_ErrorRetryCount": "10"
              }
            }
          ],
          "steps": [
            {
              "id": "s",
              "kind": "command"
            }
          ],
          "rules": [
            {
              "id": "bd",
              "when": {
                "formats": [
                  "BR*"
                ]
              },
              "then": {
                "set": {
                  "mode": {
                    "default": "mkv"
                  }
                },
                "steps": [
                  "s"
                ]
              }
            }
          ]
        },
        "drive": "d1",
        "facts": {
          "name": "X",
          "label": "X",
          "formatCode": "BR",
          "kind": "movie",
          "automatic": true
        },
        "session": {
          "titles": {
            "maxTitles": 1
          }
        }
      },
      "expect": {
        "profile": {
          "mode": {
            "default": "mkv"
          },
          "titles": {
            "strategy": "longest",
            "longestCount": 2,
            "maxTitles": 1
          },
          "naming": {
            "layout": "mediaServer"
          },
          "makemkv": {
            "settings": {
              "io_ErrorRetryCount": "10"
            }
          }
        },
        "steps": [
          "s"
        ],
        "trace": [
          {
            "layer": "defaults"
          },
          {
            "layer": "defaultProfile",
            "id": "default"
          },
          {
            "layer": "driveProfile",
            "id": "left"
          },
          {
            "layer": "driveOverrides",
            "id": "d1"
          },
          {
            "layer": "rule",
            "id": "bd"
          },
          {
            "layer": "session"
          }
        ]
      }
    }
  ]
