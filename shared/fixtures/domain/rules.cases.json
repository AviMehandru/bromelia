        "os": [
          {
            "device": "/dev/disk5"
          },
          {
            "device": "/dev/disk4",
            "identification": "HL-DT-ST",
            "mountPath": "/Volumes/MOVIE"
          }
        ]
      },
      "expect": {
        "joined": [
          {
            "driveId": "drv-86920bcfd062b640",
            "index": 0,
            "os": "/dev/disk4"
          },
          {
            "driveId": "drv-5b381cf7e534d705",
            "index": null,
            "os": "/dev/disk5"
          }
        ]
      }
    },
