        "input": "/i",
        "output": "/o"
      },
      "expect": {
        "arguments": null
      }
    },
    {
      "id": "remux-video-only",
      "from": [
        "shared/scenarios/tracks-hand-picked-remux.yaml"
      ],
      "given": {
        "tracks": [
          "video",
          "audio"
        ],
        "layout": [
          {
            "id": 0,
            "type": "video"
          },
          {
            "id": 1,
            "type": "audio"
          }
        ],
        "keep": [
          0
        ],
        "input": "/i.mkv",
        "output": "/o.mkv"
