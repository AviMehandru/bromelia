      "expect": {
        "arguments": [
          "-o",
          "/o.mkv",
          "--video-tracks",
          "0",
          "--no-audio",
          "/i.mkv"
        ]
      }
    },
    {
      "id": "split-arguments",
      "from": [
        "docs/architecture.md#identity-episodes-and-archiving (mkvmerge --split chapters:…)"
      ],
      "given": {
        "chapters": [
          8,
          15,
          22,
          29,
          36,
          43
        ],
        "input": "/s/t.mkv",
        "output": "/s/.part.mkv"
      },
      "expect": {
        "arguments": [
          "-o",
          "/s/.part.mkv",
          "--split",
          "chapters:8,15,22,29,36,43",
          "/s/t.mkv"
        ]
      }
    },
    {
      "id": "simple-chapters",
      "from": [
        "macos DVDNavigationTests.mapsChaptersToMKV",
        "windows ArchiveTests.PicksFirstEpisodeAndMapsChapters"
      ],
      "given": {
        "text": "CHAPTER01=00:00:00.000\nCHAPTER01NAME=x\nCHAPTER02=00:23:36.815\n"
      },
      "expect": {
        "starts": [
          0,
          1416.815
        ]
      }
    },
    {
      "id": "handbrake-defaults",
      "from": [
        "macos HandBrakeTests.arguments",
        "windows HandBrakeTests.Arguments",
        "linux /post/handbrake-arguments"
      ],
      "given": {
        "step": {
          "kind": "handbrake"
        }
      },
      "expect": {
        "background": true,
        "preset": "H.265 MKV 1080p30",
        "runsOn": {
          "succeeded": true,
          "failed": false
        }
      }
    },
    {
      "id": "handbrake-output",
      "from": [
        "macos HandBrakeTests.arguments",
        "windows HandBrakeTests.Arguments",
        "linux /post/handbrake-arguments"
      ],
      "given": {
        "step": {
          "kind": "handbrake",
          "handbrake": {
            "presetFile": "/p/archive.json"
          }
        },
        "values": {
          "outputDir": "/out/Show",
          "stem": "Show - S01E01",
          "name": "Show"
        }
      },
      "expect": {
        "output": "/out/Show/Encoded/Show - S01E01.mkv"
      }
    },
    {
      "id": "handbrake-arguments",
      "from": [
        "macos HandBrakeTests.arguments",
        "windows HandBrakeTests.Arguments",
        "linux /post/handbrake-arguments"
      ],
      "given": {
        "step": {
          "kind": "handbrake",
          "handbrake": {
            "presetFile": "/p/archive.json",
            "extraArguments": "--all-subtitles --subtitle-burned=none"
          }
        },
        "input": "/out/Show/Show - S01E01.mkv",
        "output": "/out/Show/Encoded/Show - S01E01.mkv"
      },
      "expect": {
        "arguments": [
          "--preset-import-file",
          "/p/archive.json",
          "--preset",
          "H.265 MKV 1080p30",
          "-i",
          "/out/Show/Show - S01E01.mkv",
          "-o",
          "/out/Show/Encoded/Show - S01E01.mkv",
          "--all-subtitles",
          "--subtitle-burned=none"
        ]
      }
    },
    {
      "id": "handbrake-sources",
      "from": [
        "macos HandBrakeTests.arguments",
        "windows HandBrakeTests.Arguments",
        "linux /post/handbrake-arguments"
      ],
      "given": {
        "files": [
          "/x/a.MKV",
          "/x/a.iso"
        ]
      },
      "expect": {
        "sources": [
          "/x/a.MKV"
        ]
      }
    },
    {
      "id": "handbrake-progress-filter",
      "from": [
        "macos HandBrakeTests.arguments",
        "windows HandBrakeTests.Arguments",
        "linux /post/handbrake-arguments"
      ],
      "given": {
        "lines": [
          "Encoding: task 1 of 2, 0.50 % (0.0 fps)",
          "Encoding: task 1 of 2, 3.00 %",
          "Encoding: task 1 of 2, 10.01 %",
          "Encoding: task 1 of 2, 19.99 %",
          "x264 [info]: done",
          "Encoding: task 2 of 2, 1.00 %",
          "Encoding: task 2 of 2, 95.00 %"
        ]
      },
      "expect": {
        "kept": [
          "Encoding: task 1 of 2, 0.50 % (0.0 fps)",
          "Encoding: task 1 of 2, 10.01 %",
          "x264 [info]: done",
          "Encoding: task 2 of 2, 1.00 %",
          "Encoding: task 2 of 2, 95.00 %"
        ]
      }
    },
