{
  "functions": [
    "MkvProbe.parse",
    "RipCheck.check",
    "RipCheck.tolerance",
    "Remux.arguments",
    "Split.arguments",
    "SimpleChapters.parse",
    "HandBrakeArgs.build",
    "HandBrakeArgs.output",
    "HandBrakeArgs.isSource",
    "HandBrakeArgs.keepLine",
    "BackupStructure.problem"
  ],
  "description": "Arguments for and output of mkvmerge, mkvextract and HandBrakeCLI; the checks of an MKV against its title and of a backup's structure. A backup's 'folder' lists the files in it (a trailing / is an empty folder).",
  "cases": [
    {
      "id": "probe-parse",
      "from": [
        "macos RipCheckTests.parsesMkvmergeJSON",
        "windows SafetyTests.ParsesMkvmergeJson",
        "linux /safety/rip-checks"
      ],
      "given": {
        "json": "{\"container\":{\"recognized\":true,\"supported\":true,\"properties\":{\"duration\":7212345000000}},\"tracks\":[{\"id\":0,\"type\":\"video\"},{\"id\":1,\"type\":\"audio\"},{\"id\":2,\"type\":\"subtitles\"}],\"chapters\":[{\"num_entries\":24}]}"
      },
      "expect": {
        "probe": {
          "durationSeconds": 7212.345,
          "trackTypes": [
            "video",
            "audio",
            "subtitles"
          ],
          "chapterCount": 24
        }
      }
    },
    {
      "id": "probe-unrecognised",
      "from": [
        "macos RipCheckTests.parsesMkvmergeJSON"
      ],
      "given": {
        "json": "{\"container\":{\"recognized\":false}}"
      },
      "expect": {
        "probe": null
      }
    },
