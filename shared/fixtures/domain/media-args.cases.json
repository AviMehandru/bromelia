    {
      "id": "remux-arguments",
      "from": [
        "macos RemuxTests.buildsTrackArguments",
        "windows RemuxTests.BuildsTrackArguments",
        "linux /runner/remux-args"
      ],
      "given": {
        "listing": "info-dvd.txt",
        "title": 1,
        "layout": [
          {
            "id": 0,
            "type": "video"
          },
          {
            "id": 1,
            "type": "audio"
          },
          {
            "id": 2,
            "type": "audio"
          },
          {
            "id": 3,
            "type": "audio"
          },
          {
            "id": 4,
            "type": "audio"
          },
          {
            "id": 5,
            "type": "subtitles"
          }
        ],
        "keep": [
          0,
          1,
          3
        ],
        "input": "/in.mkv",
        "output": "/out.mkv"
      },
      "expect": {
        "arguments": [
          "-o",
          "/out.mkv",
          "--video-tracks",
          "0",
          "--audio-tracks",
          "1,3",
          "--no-subtitles",
          "/in.mkv"
        ]
      }
    },
