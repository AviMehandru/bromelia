{
  "functions": [
    "TitleRules.select"
  ],
  "description": "TitleRules.select(listing, rules) → selected indices and the reason for each title (SelectionTrace). Filters, then duplicates (same segment map, length and angle), then the strategy, then maxTitles. The include/exclude text is the title name, comment, output file name, source file name, segment map, '#<source id>' and duration. Missing rule keys take the defaults of config-3.json TitleRules.",
  "cases": [
    {
      "id": "all-skips-duplicates",
      "from": [
        "macos TitleSelectorTests.allWithDuplicateSkipping",
        "linux /logic/selection"
      ],
      "given": {
        "titles": "five",
        "rules": {
          "strategy": "all"
        }
      },
      "expect": {
        "selected": [
          0,
          2,
          3,
          4
        ],
        "reasons": {
          "1": {
            "code": "titles.reason.duplicateOf",
            "params": {
              "title": 0
            }
          }
        }
      }
    },
    {
      "id": "all-keeps-duplicates",
      "from": [
        "macos TitleSelectorTests.allWithDuplicateSkipping",
        "linux /logic/selection"
      ],
      "given": {
        "titles": "five",
        "rules": {
          "strategy": "all",
          "skipDuplicates": false
        }
      },
      "expect": {
        "selected": [
          0,
          1,
          2,
          3,
          4
        ]
      }
    },
    {
