        "source": {
          "drive": {
            "index": 0,
            "device": "/dev/rdisk4"
          }
        },
        "title": "all",
        "destination": "staging",
        "transcript": "mkv-rip.txt",
        "exitCode": 0,
        "writes": [
          "title_t00.mkv"
        ],
        "transcriptFile": "jobs/1/makemkv.txt",
        "transcriptFails": true
      },
      "expect": {
        "status": "success",
        "transcriptProblem": "process.noTranscript",
        "rule": "a log that couldn't be written is on the run for the job to show"
      }
    },
    {
      "id": "rip-nothing-produced",
      "given": {
        "call": "rip",
        "source": {
          "drive": {
            "index": 0,
