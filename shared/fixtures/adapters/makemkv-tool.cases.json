        "destinationExists": false,
        "existing": [
          "staging"
        ],
        "transcript": "mkv-rip.txt",
        "exitCode": 0,
        "writes": []
      },
      "expect": {
        "error": "fs.failed",
        "launched": false,
        "lease": [],
        "rule": "a destination that is a file can't be listed: nothing runs, rather than every name looking new"
      }
    },
