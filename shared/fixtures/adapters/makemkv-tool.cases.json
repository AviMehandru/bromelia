      "expect": {
        "status": "failed",
        "rule": "a file that was there before doesn't count as produced"
      }
    },
    {
      "id": "rip-a-stray-file-is-not-a-title",
      "given": {
        "call": "rip",
        "source": {
          "drive": {
            "index": 0,
