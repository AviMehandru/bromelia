          "title_t00.mkv",
          "title_t01.mkv"
        ]
      },
      "expect": {
        "status": "failed",
        "errorCode": "makemkv.savedMismatch"
      }
    },
    {
      "id": "rip-destination-deleted-mid-run",
      "given": {
        "call": "rip",
        "source": {
          "drive": {
