        "title": "all",
        "destination": "staging",
        "existing": [
          "staging/old.mkv"
        ],
        "transcript": "mkv-rip.txt",
        "exitCode": 0,
        "deleteDestinationAfterLines": 5,
        "writes": []
      },
      "expect": {
        "status": "failed",
        "errorCode": "process.savedNothing",
        "rule": "a destination that goes away during the run holds none of the titles MakeMKV says it saved: the rip fails, never a success with nothing in it"
      }
    },
