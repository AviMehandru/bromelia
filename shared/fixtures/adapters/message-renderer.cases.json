{
  "description": "MessageTextRenderer (plan §16, session E1 2026-10-19): the host's renderer of {code, params, cause} into text from a catalog of ICU MessageFormat texts (codes.json's 'rendering'). Each case renders given.message (the JSON form, with cause) with the test catalog below, or with the generated English catalog (EnglishMessages, from shared/messages/en.json) when given.catalog is 'english'. given.via 'port' renders through the MessageRenderer port instead: the message is decoded with BroMessage.decode (no cause). catalog.messageLists names the params that are messageList (joined ', '; 'messages' are joined '; '). Numbers have no grouping; bytes are decimal units rounded half up to one decimal (unit chosen after rounding); duration is m:ss or h:mm:ss (fractions dropped), durationPrecise h:mm:ss.sss (rounded to the millisecond). A missing or null param renders as {name} (a select picks other); an unknown code renders the code; an unclosed brace renders the rest as text. Apostrophes follow ICU: '' is one, and an apostrophe before { or } (or # in a plural) quotes up to the next one.",
  "catalog": {
    "texts": {
      "plain": "Hello",
      "path": "Copying {path}",
      "count": "{n} files",
      "flag": "flag is {flag}",
      "names": "Names: {names}",
      "titles": "{n, plural, =0 {no titles} one {# title} other {# titles}}",
      "exactOne": "{n, plural, =1 {just one} one {# title} other {# titles}}",
      "noZero": "{n, plural, one {# title} other {# titles}}",
      "hash": "Track #{n}",
      "nestedPlural": "{kind, select, dvd {{n, plural, one {# DVD} other {# DVDs}}} other {{n} discs}}",
      "pluralSelect": "{n, plural, other {# in {kind, select, dvd {DVD #} other {other}}}}",
      "kind": "{kind, select, dvd {DVD} bluray {Blu-ray} other {unknown format}}",
      "yesNo": "{done, select, true {done} other {not done}}",
      "size": "{size, bytes}",
      "twoSizes": "need {need, bytes}, free {free, bytes}",
      "length": "{s, duration}",
      "precise": "{s, durationPrecise}",
      "reason": "Failed: {reason}",
      "inner": "the {thing} broke",
      "leaf": "disk full",
      "notes": "Notes: {notes}",
      "listed": "{parts} of {total}",
      "part": "{n} {what}",
      "spaces": "{ n , plural , one { # item } other { # items } }",
      "unknownFormat": "{n, number}",
      "apostrophe": "don't stop",
      "doubled": "it''s {n}",
      "quoted": "'{n}' is {n}",
      "quotedHash": "{n, plural, other {'#' is #}}",
      "quotedBrace": "{kind, select, a {'}' here} other {x}}",
      "quotedDoubled": "'{it''s}'",
      "twice": "{n, plural, other {first} other {second}}",
      "unbalanced": "Broken {n",
      "unbalancedBranch": "{n, plural, one {# title other {# titles}}"
    },
    "messageLists": {
      "listed": [
        "parts"
      ]
    }
  },
  "cases": [
    {
      "id": "plain-text",
      "given": {
        "message": {
          "code": "plain"
        }
      },
      "expect": {
        "text": "Hello"
      }
    },
