{
  "description": "PlatformKeystore (plan §10.3): get / set / remove of secrets by SecretRef name (common.json#/$defs/SecretRef: ^[a-z][a-zA-Z0-9]*(\\.[A-Za-z0-9_-]+)*$). Each case starts from an empty keystore: the tests give the adapter a store of its own (a Keychain service, a Credential Manager target prefix, a libsecret schema attribute, an empty fallback folder) and remove what they wrote. given.steps run in order; expect.results has one entry per step: for get the value (null: no such secret), for set and remove null, or {error: code} when the step fails (and changes nothing). 'value' is the text; {repeat, times} is that text repeated. Names that differ only in case aren't covered: Credential Manager and the macOS file system don't tell them apart. When the fallback folder is on a network share (the tests' temporary folder on an SMB mount), every get and set of the fallback files fails with fs.notPrivate instead and remove works as usual (platform-adapters.contract.json, secrets-never-on-a-share).",
  "cases": [
    {
      "id": "missing-is-none",
      "given": {
        "steps": [
          {
            "op": "get",
            "name": "metadata.tmdb"
          }
        ]
      },
      "expect": {
        "results": [
          null
        ]
      }
    },
    {
      "id": "set-then-get",
      "given": {
        "steps": [
          {
            "op": "set",
            "name": "metadata.tmdb",
            "value": "abc123"
          },
          {
            "op": "get",
            "name": "metadata.tmdb"
          }
        ]
      },
      "expect": {
        "results": [
          null,
          "abc123"
        ]
      }
    },
    {
      "id": "set-replaces",
      "given": {
        "steps": [
          {
            "op": "set",
            "name": "server.token",
            "value": "first"
          },
          {
            "op": "set",
            "name": "server.token",
            "value": "second"
          },
          {
            "op": "get",
            "name": "server.token"
          }
        ]
      },
      "expect": {
        "results": [
          null,
          null,
          "second"
        ]
      }
    },
    {
      "id": "remove",
      "given": {
        "steps": [
          {
            "op": "set",
            "name": "notify.home",
            "value": "ntfy://topic"
          },
          {
            "op": "remove",
            "name": "notify.home"
          },
          {
            "op": "get",
            "name": "notify.home"
          }
        ]
      },
      "expect": {
        "results": [
          null,
          null,
          null
        ]
      }
    },
    {
      "id": "remove-missing-is-fine",
      "given": {
        "steps": [
          {
            "op": "remove",
            "name": "notify.never"
          },
          {
            "op": "get",
            "name": "notify.never"
          }
        ]
      },
      "expect": {
        "results": [
          null,
          null
        ]
      }
    },
    {
      "id": "names-are-independent",
      "given": {
        "steps": [
          {
            "op": "set",
            "name": "notify.a",
            "value": "one"
          },
          {
            "op": "set",
            "name": "notify.b",
            "value": "two"
          },
          {
            "op": "set",
            "name": "notify",
            "value": "three"
          },
          {
            "op": "remove",
            "name": "notify.a"
          },
          {
            "op": "get",
            "name": "notify.a"
          },
          {
            "op": "get",
            "name": "notify.b"
          },
          {
            "op": "get",
            "name": "notify"
          }
        ]
      },
      "expect": {
        "results": [
          null,
          null,
          null,
          null,
          null,
          "two",
          "three"
        ]
      }
    },
    {
      "id": "any-text",
      "given": {
        "steps": [
          {
            "op": "set",
            "name": "notify.x_1-2",
            "value": "pässwörd & “quotes” 🔑\nsecond line\n  "
          },
          {
            "op": "get",
            "name": "notify.x_1-2"
          }
        ]
      },
      "expect": {
        "results": [
          null,
          "pässwörd & “quotes” 🔑\nsecond line\n  "
        ]
      }
    },
    {
      "id": "empty-value",
      "given": {
        "steps": [
          {
            "op": "set",
            "name": "metadata.omdb",
            "value": ""
          },
          {
            "op": "get",
            "name": "metadata.omdb"
          }
        ]
      },
      "expect": {
        "results": [
          null,
          ""
        ]
      }
    },
    {
      "id": "long-value",
      "given": {
        "steps": [
          {
            "op": "set",
            "name": "notify.long",
            "value": {
              "repeat": "0123456789",
              "times": 200
            }
          },
          {
            "op": "get",
            "name": "notify.long"
          }
        ]
      },
      "expect": {
        "results": [
          null,
          {
            "repeat": "0123456789",
            "times": 200
          }
        ]
      }
    },
    {
      "id": "not-secret-names",
      "given": {
        "steps": [
          {
            "op": "set",
            "name": "",
            "value": "x"
          },
          {
            "op": "set",
            "name": "../escape",
            "value": "x"
          },
          {
            "op": "set",
            "name": "notify/home",
            "value": "x"
          },
          {
            "op": "set",
            "name": "Metadata.tmdb",
            "value": "x"
          },
          {
            "op": "set",
            "name": "notify..home",
            "value": "x"
          },
          {
            "op": "set",
            "name": "notify.",
            "value": "x"
          },
          {
            "op": "set",
            "name": "notify home",
            "value": "x"
          },
          {
            "op": "get",
            "name": "../escape"
          },
          {
            "op": "remove",
            "name": "../escape"
          }
        ]
      },
      "expect": {
        "results": [
          {
            "error": "keystore.failed"
          },
          {
            "error": "keystore.failed"
          },
          {
            "error": "keystore.failed"
          },
          {
            "error": "keystore.failed"
          },
          {
            "error": "keystore.failed"
          },
          {
            "error": "keystore.failed"
          },
          {
            "error": "keystore.failed"
          },
          {
            "error": "keystore.failed"
          },
          {
            "error": "keystore.failed"
          }
        ]
      }
    }
  ]
}
