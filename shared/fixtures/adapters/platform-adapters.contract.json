{
  "functions": [
    "ProcessLauncher.start",
    "RunningProcess.stop",
    "DriveControl.openRaw",
    "DriveControl.closeTray",
    "SettingsIsolation.prepare",
    "PowerManager.inhibit",
    "EngineLock.acquire",
    "FileSystem.writeAtomically",
    "FileSystem.openForReading",
    "FileSystem.createDirectory",
    "PlatformProcessLauncher.invocation"
  ],
  "description": "What every platform's adapters must do on the real OS (plan §26, 'Platform adapters'). These aren't run by a shared runner: each platform's adapter tests implement every case.",
  "cases": [
    {
      "id": "stall-stops",
      "from": [
        "macos ReliabilityTests.stuckProcessIsStopped",
        "windows ReliabilityTests.StuckProcessIsStopped",
        "linux /reliability/stuck-process"
      ],
      "given": {
        "command": [
          "/bin/sh",
          "-c",
          "echo started; sleep 60"
        ],
        "stopPolicy": "terminateFirst",
        "stallTimeout": 2
      },
      "expect": {
        "stalled": true,
        "exitNonZero": true,
        "within": 15,
        "lines": [
          "started"
        ]
      }
    },
    {
      "id": "busy-not-stopped",
      "from": [
        "macos ReliabilityTests.busyProcessIsNotStopped",
        "windows ReliabilityTests.BusyProcessIsNotStopped",
        "linux /reliability/stuck-process"
      ],
      "given": {
        "command": [
          "/bin/sh",
          "-c",
          "for i in 1 2 3 4 5 6; do echo $i; sleep 0.5; done"
        ],
        "stallTimeout": 2
      },
      "expect": {
        "stalled": false,
        "exitCode": 0
      }
    },
    {
      "id": "cancel-escalates",
      "from": [
        "linux /reliability/cancel-without-main-loop",
        "rearchitecture-plan §9 RunningProcess.stop ((INT →) TERM → KILL, 5 s apart)"
      ],
      "given": {
        "command": "a child that ignores SIGINT (sh: trap '' INT)",
        "stopPolicy": "interruptFirst",
        "cancelAfter": 0.5
      },
      "expect": {
        "cancelled": true,
        "within": 12,
        "signals": [
          "INT",
          "TERM after 5 s",
          "KILL after 10 s"
        ],
        "endedBy": "TERM",
        "rule": "Works without any main loop running (the watchdog has its own thread).",
        "windows": "No signals: TerminateJobObject at once, exit status -1, no signal."
      }
    },
    {
      "id": "terminate-first",
      "from": [
        "docs/architecture.md#stopping-processes (makemkvcon ignores SIGINT: SIGTERM, then SIGKILL after 5 s)"
      ],
      "given": {
        "command": "a child that ignores SIGINT and SIGTERM",
        "stopPolicy": "terminateFirst"
      },
      "expect": {
        "signals": [
          "TERM",
          "KILL after 5 s"
        ],
        "endedBy": "KILL",
        "exitStatus": -1
      }
    },
    {
      "id": "abandon",
      "from": [
        "docs/architecture.md#stopping-processes (still there 30 s after SIGKILL → abandoned)"
      ],
      "given": {
        "command": "a child stuck in the kernel"
      },
      "expect": {
        "abandoned": true,
        "within": 36,
        "note": "Not reproducible in a test (a process stuck in the kernel); covered by reading the code."
      }
    },
    {
      "id": "output-drained",
      "from": [
        "docs/architecture.md#stopping-processes (output read for at most 5 more seconds after exit)"
      ],
      "given": {
        "command": [
          "/bin/sh",
          "-c",
          "sleep 20 & echo done"
        ]
      },
      "expect": {
        "returnsWithin": 8,
        "lines": [
          "done"
        ],
        "exitCode": 0
      }
    },
    {
      "id": "late-output-goes-nowhere",
      "from": [
        "review of phases 0–2, P2-3: the transcript was closed while a reader still wrote to it"
      ],
      "given": {
        "command": [
          "/bin/sh",
          "-c",
          "(sleep 6; echo late) & echo early"
        ],
        "transcript": "late.txt",
        "then": "right after wait returns, open 20 files and keep them open for 2 s"
      },
      "expect": {
        "lines": [
          "early"
        ],
        "transcriptHas": [
          "early"
        ],
        "transcriptLacks": [
          "the line late"
        ],
        "openedFilesEmpty": true,
        "rule": "a line read after the process has ended (a child left behind kept the pipe open past 5 s) is dropped: it never reaches the transcript, which is closed, nor a file that reuses the transcript's descriptor; the transcript is written under the launcher's lock, so a reader still holding a line when the process ends can't write either"
      }
    },
    {
      "id": "process-group",
      "from": [
        "rearchitecture-plan §10.3 (posix_spawn + process group; Job Object; setpgid)"
      ],
      "given": {
        "command": [
          "/bin/sh",
          "-c",
          "sleep 60 & echo $! > child.pid; sleep 60"
        ]
      },
      "expect": {
        "stopKillsTheGroup": true,
        "rule": "Signals go to the process group; once a stopped process has ended, what is left of its group is killed (a shell's background child ignores SIGINT). A process left running after a normal exit is left alone.",
        "windows": "The Job Object: TerminateJobObject ends every process in it."
      }
    },
    {
      "id": "transcript",
      "from": [
        "docs/architecture.md#per-drive-makemkv-settings (every line, headed by the command line, followed by the exit status)"
      ],
      "given": {
        "command": [
          "/bin/echo",
          "hi"
        ],
        "transcript": "t.txt"
      },
      "expect": {
        "transcript": "==== <instant> $ /bin/echo hi\nhi\n==== <instant> exit status 0\n",
        "endings": {
          "exit": "exit status <n>",
          "signal": "signal <n>",
          "abandoned": "abandoned",
          "then": ", stalled / , cancelled when they apply",
          "couldNotStart": "==== <instant> could not start: <reason>"
        },
        "commandLine": "ArgumentSplitter.quote of each word of the invocation (after the interpreter choice)"
      }
    },
    {
      "id": "exit-reporting",
      "from": [
        "rearchitecture-plan §9 ProcessExit"
      ],
      "given": {
        "cases": [
          "exits with n",
          "killed by a signal",
          "stopped (cancelled or shutdown)",
          "stalled"
        ]
      },
      "expect": {
        "exit": "status n, no signal",
        "signal": "status -1, signal n (macOS, Linux)",
        "cancelled": "cancelled true for StopReason cancelled and shutdown",
        "stalled": "stalled = the silence that stopped it",
        "abandoned": "status -1, abandoned true"
      }
    },
    {
      "id": "output-lines",
      "from": [
        "docs/architecture.md (lines split on \\n, \\r or \\r\\n; empty lines dropped)"
      ],
      "given": {
        "command": [
          "/bin/sh",
          "-c",
          "echo $X; pwd; echo oops >&2"
        ],
        "environment": {
          "X": "from the spec"
        },
        "workingDirectory": "<dir>"
      },
      "expect": {
        "lines": [
          {
            "stream": "stdout",
            "text": "from the spec"
          },
          {
            "stream": "stdout",
            "text": "<dir>"
          },
          {
            "stream": "stderr",
            "text": "oops"
          }
        ],
        "rule": "The spec's environment is added to the engine's; stdin is empty (/dev/null); invalid UTF-8 is replaced."
      }
    },
    {
      "id": "could-not-start",
      "from": [
        "rearchitecture-plan §9 ProcessLauncher.start"
      ],
      "given": {
        "cases": [
          "a program that doesn't exist",
          "a working folder that doesn't exist"
        ]
      },
      "expect": {
        "error": {
          "code": "process.couldNotStart",
          "params": {
            "tool": "<program's file name>",
            "reason": "<the system's reason>"
          }
        }
      }
    },
    {
      "id": "interpreter",
      "from": [
        "macos TemplateTests.postProcessInvocation",
        "windows TemplateTests.PostProcessInvocation",
        "docs/architecture.md#post-processing (scripts run through an interpreter)"
      ],
      "given": {
        "cases": [
          "spec.interpreter set",
          "a script without the execute bit (macOS, Linux)",
          ".ps1 / .bat / .cmd / .py (Windows)"
        ]
      },
      "expect": {
        "interpreter": "<interpreter> <script> <arguments>",
        "noExecuteBit": "/bin/sh <script> <arguments>",
        "windows": {
          ".ps1": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File <script>",
          ".bat": "%ComSpec% /c <script>",
          ".cmd": "%ComSpec% /c <script>",
          ".py": "py.exe <script>"
        },
        "function": "PlatformProcessLauncher.invocation"
      }
    },
    {
      "id": "windows-drive-letters",
      "from": [
        "windows IntegrationFeatureTests.OnlyDriveLettersAreReadAsDevices"
      ],
      "given": {
        "platform": "windows",
        "paths": [
          "e:",
          "E:\\",
          "C:\\Users\\me\\disc.bin",
          "/dev/sr0",
          "E:"
        ],
        "raw": [
          true,
          true,
          true,
          false,
          false
        ]
      },
      "expect": {
        "devicePaths": [
          "\\\\.\\E:",
          "\\\\.\\E:",
          "C:\\Users\\me\\disc.bin",
          "/dev/sr0",
          "E:"
        ],
        "rule": "Only a bare drive letter is read as a device; a file on C: is read as that file."
      }
    },
    {
      "id": "drutil-match",
      "from": [
        "macos IntegrationFeatureTests.drutilListIsMatchedByModel"
      ],
      "given": {
        "platform": "macos",
        "lines": [
          "   Vendor   Product           Rev   Bus       SupportLevel",
          "1  HL-DT-ST BD-RE  WH16NS60  1.02  USB       Unsupported",
          "2  PIONEER  BD-RW   BDR-XS07 1.04  USB       Unsupported"
        ],
        "match": [
          "BD-RE HL-DT-ST BD-RE  WH16NS60 1.02 KLAM6E84325",
          ""
        ]
      },
      "expect": {
        "indices": [
          [
            1
          ],
          [
            1,
            2
          ]
        ]
      }
    },
    {
      "id": "settings-isolation-home",
      "from": [
        "macos MakeMKVFileTests.environmentIsolatesSettings",
        "windows FileFormatTests.EnvironmentBuildsArguments",
        "linux /makemkv/environment"
      ],
      "given": {
        "platform": "macos|linux",
        "settings": {
          "dvd_MinimumTitleLength": "30"
        }
      },
      "expect": {
        "settingsFile": {
          "macos": "<home>/Library/MakeMKV/settings.conf",
          "linux": "<home>/.MakeMKV/settings.conf"
        },
        "environment": {
          "HOME": "<home>"
        },
        "profileWritten": true
      }
    },
    {
      "id": "settings-isolation-registry",
      "from": [
        "docs/architecture.md#per-drive-makemkv-settings (Windows)",
        "README.md limitations"
      ],
      "given": {
        "platform": "windows",
        "settings": {
          "dvd_MinimumTitleLength": "30"
        }
      },
      "expect": {
        "registry": "HKCU\\Software\\MakeMKV gets the drive's values (other catalogue keys cleared) and the previous values back on the first output line, the exit or after 15 s; launches are serialised (MakemkvLaunch lease); a warning when the MakeMKV GUI runs"
      }
    },
    {
      "id": "power-guard",
      "from": [
        "macos ReliabilityTests.backgroundStepsKeepTheMacAwake",
        "windows ReliabilityTests.BackgroundStepsKeepTheComputerAwake",
        "linux /reliability/keep-awake"
      ],
      "given": {
        "inhibit": "while held"
      },
      "expect": {
        "macos": "IOPMAssertion (no idle sleep)",
        "windows": "SetThreadExecutionState(ES_SYSTEM_REQUIRED) on a dedicated thread",
        "linux": "logind Inhibit('sleep:idle', 'Bromelia', …, 'block'), fd kept open",
        "replacingReleasesTheOldOne": true
      }
    },
    {
      "id": "power-no-logind",
      "from": [
        "linux /reliability/keep-awake-without-logind"
      ],
      "given": {
        "platform": "linux",
        "env": {
          "DBUS_SYSTEM_BUS_ADDRESS": "unix:path=/nonexistent/bromelia-test-bus"
        },
        "inhibit": [
          true,
          false,
          true
        ]
      },
      "expect": {
        "problemsReported": 1
      }
    },
    {
      "id": "engine-lock",
      "from": [
        "macos HeadlessTests.automationLock",
        "windows AutomationLockTests.OneHolderAtATime",
        "linux /state/automation-lock"
      ],
      "given": {
        "lockFile": "<data>/run/engine.lock",
        "holders": [
          "first",
          "second"
        ]
      },
      "expect": {
        "first": "acquires",
        "second": {
          "error": {
            "code": "host.alreadyRunning",
            "params": {
              "pid": "<first's pid>"
            }
          }
        },
        "afterFirstReleases": "second acquires",
        "note": "Replaces automation.lock (and its one-minute takeover): exactly one engine per user."
      }
    },
    {
      "id": "tls-identity",
      "from": [
        "macos WebTests.tlsIdentity",
        "windows WebApiTests.ServesHttps",
        "linux /web/tls"
      ],
      "given": {
        "certificate": "a self-signed PEM certificate",
        "key": "its PEM key"
      },
      "expect": {
        "loads": true,
        "wrongKey": "fails with server.startFailed {reason: tls.*}",
        "macosKeychain": "never the login keychain"
      }
    },
    {
      "id": "file-system-durable-write",
      "from": [
        "rearchitecture-plan §9 FileSystem.writeAtomically, I3"
      ],
      "given": {
        "write": "a.json"
      },
      "expect": {
        "temporaryThenRename": true,
        "fsyncFileAndFolder": {
          "macos": "F_FULLFSYNC",
          "windows": "FlushFileBuffers",
          "linux": "fsync"
        }
      }
    },
    {
      "id": "file-system-read-uncached",
      "from": [
        "rearchitecture-plan §22.3 (hash read back from disk)"
      ],
      "given": {
        "openForReading": {
          "bypassCache": true
        }
      },
      "expect": {
        "macos": "F_NOCACHE",
        "windows": "FILE_FLAG_NO_BUFFERING",
        "linux": "posix_fadvise(DONTNEED)"
      }
    },
    {
      "id": "file-system-never-creates-library-root",
      "from": [
        "rearchitecture-plan §9 createDirectory(parentsMustExist), I2"
      ],
      "given": {
        "createDirectory": "<library>/Movies/X",
        "libraryRootExists": false
      },
      "expect": {
        "error": "the root isn't created"
      }
    }
  ]
}
