{
  "title": "A stop that begins during Commit's move waits for the commit, and the next start resumes the job at Commit",
  "phase": 3,
  "from": [
    "rearchitecture-plan §22.3, §20.4 (a commit that holds its unit runs to its end; the job resumes after a restart)",
    "invariants I1, I3, I5",
    "H1-6 (2026-10-31): G's open item, a stop during Commit's move"
  ],
  "given": {
    "disc": "sample-movie",
    "profile": {
      "titles": {
        "skipDuplicates": false
      }
    }
  },
  "steps": [
    {
      "rip": {
        "iso": true,
        "titles": [
          0,
          1
        ],
        "as": "job"
      }
    },
    {
      "stop": {
        "at": "commit.afterMove:1"
      }
    },
    {
      "restart": {}
    },
    {
      "expect": {
        "job": {
          "name": "job",
          "outcome": "succeeded",
          "unit": {
            "state": "committed"
          }
        },
        "files": {
          "under": "library/Sample Movie",
          "include": [
            "Sample Movie - Rip - Playlist 00001 - BR.mkv",
            "Sample Movie - Rip - Playlist 00002 - BR.mkv",
            "SHA256SUMS",
            "bromelia-{unit8}.json"
          ]
        },
        "sums": {
          "folder": "library/Sample Movie",
          "ok": true
        },
        "db": {
          "commit_intents": {
            "count": 0
          },
          "archive_units": {
            "count": 1,
            "rows": [
              {
                "state": "committed"
              }
            ]
          }
        },
        "log": {
          "job": "job",
          "include": [
            "recovery.resumed"
          ]
        }
      }
    }
  ]
}
