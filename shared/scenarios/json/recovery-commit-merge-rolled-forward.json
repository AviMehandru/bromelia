{
  "title": "A commit into a folder an earlier unit shares, killed between its items, is rolled forward without losing or doubling either unit's checksums",
  "phase": 3,
  "from": [
    "rearchitecture-plan §22.3 (a crash inside 5 rolls forward; SHA256SUMS merged in a shared folder)",
    "docs/configuration.md#media-server-layout",
    "invariants I1, I3, I5",
    "I1 decision 299 (S3): a merge into a shared folder end to end"
  ],
  "given": {
    "drives": [
      {
        "id": "drive",
        "name": "Test drive",
        "identification": "BD-RE TEST DRIVE 1.00 SN1",
        "device": "/dev/test0",
        "disc": "sample-movie-one-title"
      }
    ],
    "profile": {
      "naming": {
        "layout": "mediaServer"
      },
      "mode": {
        "default": "backupThenMkv"
      }
    },
    "tools": {
      "makemkvcon": "tools/makemkvcon-backup-two-folders.yaml"
    },
    "units": [
      {
        "folder": "library/Movies/Sample Movie",
        "name": "Sample Movie",
        "files": [
          "Sample Movie - Theatrical.mkv",
          "Backup/Sample Movie - Theatrical - Backup - BR/BDMV/index.bdmv"
        ]
      }
    ]
  },
  "steps": [
    {
      "rip": {
        "drive": "drive",
        "as": "job"
      }
    },
    {
      "kill": {
        "at": "commit.afterMove:1"
      }
    },
    {
      "restart": {}
    },
    {
      "expect": {
        "job": {
          "name": "job",
          "outcome": "succeeded",
          "unit": {
            "state": "committed"
          }
        },
        "files": {
          "under": "library/Movies/Sample Movie",
          "include": [
            "Sample Movie - Theatrical.mkv",
            "Backup/Sample Movie - Theatrical - Backup - BR/BDMV/index.bdmv",
            "Sample Movie.mkv",
            "Backup/Sample Movie - Backup - BR/BDMV/index.bdmv",
            "Backup/Sample Movie - Backup - BR/CERTIFICATE/id.bdmv",
            "Backup/.plexignore",
            "Backup/.ignore",
            "bromelia-{unit8}.json",
            "bromelia-00000000.json"
          ]
        },
        "sums": {
          "folder": "library/Movies/Sample Movie",
          "ok": true,
          "files": [
            "Sample Movie - Theatrical.mkv",
            "Backup/Sample Movie - Theatrical - Backup - BR/BDMV/index.bdmv",
            "Sample Movie.mkv",
            "Backup/Sample Movie - Backup - BR/BDMV/index.bdmv",
            "Backup/Sample Movie - Backup - BR/CERTIFICATE/id.bdmv"
          ]
        },
        "log": {
          "job": "job",
          "include": [
            "recovery.resumed",
            "commit.rolledForward"
          ]
        },
        "db": {
          "commit_intents": {
            "count": 0
          },
          "archive_units": {
            "count": 2,
            "rows": [
              {
                "state": "committed"
              },
              {
                "state": "committed"
              }
            ]
          }
        }
      }
    }
  ]
}
