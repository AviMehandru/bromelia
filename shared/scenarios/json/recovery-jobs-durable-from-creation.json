{
  "title": "Jobs are in the database from the moment they are created until they finish, so a crash can't lose one",
  "phase": 3,
  "from": [
    "macos ReliabilityTests.unfinishedJobsAreRecordedAfterAStop (this process's own jobs are written down while they wait)",
    "README.md (nothing lost on a crash)",
    "owner H3b-7 (2026-10-31): a job waiting for a slot after its first steps is stored running"
  ],
  "given": {
    "disc": "sample-movie-one-title",
    "tools": {
      "makemkvcon": "tools/makemkvcon-stalls.yaml"
    }
  },
  "steps": [
    {
      "rip": {
        "iso": true,
        "as": "running"
      }
    },
    {
      "rip": {
        "iso": true,
        "as": "queued"
      }
    },
    {
      "expect": {
        "when": {
          "job": "running",
          "step": "acquire"
        },
        "db": {
          "jobs": {
            "count": 2,
            "rows": [
              {
                "state": "running"
              },
              {
                "state": "running"
              }
            ]
          }
        }
      }
    },
    {
      "cancel": "queued"
    },
    {
      "expect": {
        "when": {
          "job": "queued",
          "state": "finished"
        },
        "job": {
          "name": "queued",
          "outcome": "cancelled"
        }
      }
    }
  ]
}
