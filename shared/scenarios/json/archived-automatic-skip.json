{
  "title": "An automatic rip of a disc archived before is skipped (and the disc ejected when ejectWhenDone is on)",
  "phase": 3,
  "from": [
    "macos ArchiveCheckTests.discsArchivedBefore",
    "docs/configuration.md#archive-check (discs archived before)",
    "owner H3b-4 (2026-10-31): the disc goes back in before the automatic rip; H3b-5: a glob in a json subset"
  ],
  "given": {
    "drives": [
      {
        "id": "drive",
        "name": "Test drive",
        "identification": "BD-RE TEST DRIVE 1.00 SN1",
        "device": "/dev/test0",
        "disc": "sample-movie-one-title"
      }
    ],
    "configPatch": {
      "automation": {
        "defaults": {
          "ejectWhenDone": true
        }
      }
    }
  },
  "steps": [
    {
      "rip": {
        "drive": "drive",
        "as": "first"
      }
    },
    {
      "expect": {
        "job": {
          "name": "first",
          "outcome": "succeeded"
        },
        "record": {
          "folder": "library/Sample Movie",
          "json": {
            "disc": {
              "fingerprint": "v1:*"
            }
          }
        }
      }
    },
    {
      "closeTray": {
        "drive": "drive"
      }
    },
    {
      "rip": {
        "drive": "drive",
        "automatic": true,
        "as": "again"
      }
    },
    {
      "expect": {
        "job": {
          "name": "again",
          "outcome": "skipped",
          "error": {
            "code": "disc.alreadyArchived",
            "params": {
              "folder": "{root}/library/Sample Movie"
            }
          },
          "unit": {}
        },
        "calls": {
          "makemkvcon": {
            "counts": {
              " mkv ": 1
            }
          }
        },
        "db": {
          "archive_units": {
            "count": 1
          }
        }
      }
    }
  ]
}
