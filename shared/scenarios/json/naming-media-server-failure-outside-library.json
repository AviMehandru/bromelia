{
  "title": "In the media server layout a failed job's files, kept apart, are quarantined outside the library's show and movie folders",
  "from": [
    "docs/configuration.md#media-server-layout",
    "owner decision 2026-10-25 (a failed job's staging stays hidden for a retry; keep-apart or the next start moves it to _Quarantine)"
  ],
  "given": {
    "disc": "sample-movie-one-title",
    "profile": {
      "naming": {
        "layout": "mediaServer"
      }
    },
    "tools": {
      "makemkvcon": "tools/makemkvcon-fails-file-written.yaml"
    }
  },
  "steps": [
    {
      "rip": {
        "iso": true,
        "as": "job"
      }
    },
    {
      "expect": {
        "job": {
          "name": "job",
          "outcome": "failed"
        },
        "files": {
          "under": "library",
          "include": [
            ".bromelia/staging/{jobId}/title_t00.mkv"
          ],
          "exclude": [
            "Movies",
            "_Quarantine"
          ]
        }
      }
    },
    {
      "keepApart": "job"
    },
    {
      "expect": {
        "job": {
          "name": "job",
          "outcome": "cancelled"
        },
        "files": {
          "under": "library",
          "include": [
            "_Quarantine/Sample Movie [INCOMPLETE]/title_t00.mkv"
          ],
          "exclude": [
            "Movies",
            ".bromelia/staging/{jobId}"
          ]
        }
      }
    }
  ]
}
